{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "custom-worker.js",
  "triggers": { "crons": ["15 3 * * *"] },
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "efficience-globale-db",
      "database_id": "e0926e87-94cb-4645-a6bd-abf57518f3bd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "eguploads"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
